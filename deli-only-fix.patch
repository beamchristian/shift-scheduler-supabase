From c66a482fc3e0841acac61bf6696fc607302c9be6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 20:35:28 -0400
Subject: [PATCH] Show only the Deli department until per-department scoping is
 finished

Migration 006 sets Deli as the default department and removes the extra
store hours created for the other departments. The app reads only Deli's
rows, so the other departments' data can't double the totals.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Dbibe2AFHP4aR2mKEVHoEr
---
 lib/db.ts                                       | 8 ++++----
 supabase/migrations/006_department_defaults.sql | 9 +++++++++
 2 files changed, 13 insertions(+), 4 deletions(-)
 create mode 100644 supabase/migrations/006_department_defaults.sql

diff --git a/lib/db.ts b/lib/db.ts
index e065d5d..50dad90 100644
--- a/lib/db.ts
+++ b/lib/db.ts
@@ -138,9 +138,9 @@ export async function snapshot(): Promise<Snapshot> {
   await ensureSeed();
   const r = await q<Snapshot>(`select
     (select to_jsonb(s) from settings s where s.id = 1) as settings,
-    (select coalesce(jsonb_agg(to_jsonb(h) order by h.day), '[]'::jsonb) from store_hours h) as store_hours,
-    (select coalesce(jsonb_agg(to_jsonb(e) order by e.id), '[]'::jsonb) from employees e) as employees,
-    (select coalesce(jsonb_agg(to_jsonb(t) order by t.day, t."start", t.name, t.id), '[]'::jsonb) from shift_templates t) as shift_templates,
-    (select coalesce(jsonb_agg(to_jsonb(x) order by x.id), '[]'::jsonb) from schedule x) as schedule`);
+    (select coalesce(jsonb_agg(to_jsonb(h) order by h.day), '[]'::jsonb) from store_hours h where h.department_id = 1) as store_hours,
+    (select coalesce(jsonb_agg(to_jsonb(e) order by e.id), '[]'::jsonb) from employees e where e.department_id = 1) as employees,
+    (select coalesce(jsonb_agg(to_jsonb(t) order by t.day, t."start", t.name, t.id), '[]'::jsonb) from shift_templates t where t.department_id = 1) as shift_templates,
+    (select coalesce(jsonb_agg(to_jsonb(x) order by x.id), '[]'::jsonb) from schedule x where x.department_id = 1) as schedule`);
   return r[0];
 }
diff --git a/supabase/migrations/006_department_defaults.sql b/supabase/migrations/006_department_defaults.sql
new file mode 100644
index 0000000..42c79c5
--- /dev/null
+++ b/supabase/migrations/006_department_defaults.sql
@@ -0,0 +1,9 @@
+-- Run once in Supabase: SQL Editor > New query > paste > Run.
+-- New rows go to Deli (department 1) until the app is scoped to each department.
+alter table store_hours alter column department_id set default 1;
+alter table employees alter column department_id set default 1;
+alter table shift_templates alter column department_id set default 1;
+alter table schedule alter column department_id set default 1;
+-- Remove the 36 extra store-hours rows created for the other six departments, so the app shows only Deli.
+-- They are recreated per department when the department feature is finished.
+delete from store_hours where department_id <> 1;
-- 
